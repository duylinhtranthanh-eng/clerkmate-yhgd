# ClerkMate — environment
#
# The app runs with none of these set. Leaving them unset keeps AI note
# structuring switched off entirely, and the app makes zero network calls.

# --- server side, set in the Netlify UI (never in the repo) ------------------
# These are read by netlify/functions/ai-structure-note.mjs and stay on the
# server. They are NOT prefixed with VITE_, so they never enter the browser
# bundle. Setting AI_API_KEY is what turns AI mode on.
#
# AI_API_KEY=sk-...
# AI_PROVIDER=anthropic          # anthropic (default) | openai
# AI_MODEL=claude-sonnet-5       # claude-haiku-4-5-20251001 responds faster
# AI_API_URL=                    # override the provider endpoint if needed

# --- client side (shipped in the bundle — never put a secret here) -----------
# Only needed if the proxy is hosted somewhere other than this site.
# VITE_AI_API_URL=/.netlify/functions/ai-structure-note
#
# There is deliberately no VITE_AI_API_KEY. Anything prefixed VITE_ is inlined
# into the JavaScript that every visitor downloads, so a key placed there is a
# published key.
