{
  "name": "clerkmate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ClerkMate - from bedside notes to structured Family Medicine clinical learning records. Local-first MVP.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -p tsconfig.app.json --noEmit",
    "deploy": "npm run build && npx netlify-cli deploy --prod --dir=dist",
    "test": "node scripts/audit.mjs",
    "verify:app": "node scripts/verify/verify-final.mjs",
    "verify:print": "node scripts/verify/verify-print.mjs",
    "preview:pages": "vite preview --port 4191 --base /clerkmate-yhgd/ --strictPort",
    "verify:profiles": "node scripts/verify/verify-profiles.mjs",
    "verify:capture": "node scripts/verify/verify-capture.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
